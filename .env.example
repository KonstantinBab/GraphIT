# Paths to local model artifacts.
# Keep these files outside Git if they are large or private.
GRAPHIT_HOST=localhost
GRAPHIT_PORT=7860

GRAPHIT_EMBEDDER_PATH=../augmentation/berta_finetuned_v6_second/final
GRAPHIT_SELECTOR_PATH=../train_selector/selector_finetuned_7b_v6/final
GRAPHIT_SELECTOR_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
GRAPHIT_CLASSIFIER_PATH=../train_classification/classifier_llm_v7/final
GRAPHIT_CODES_FILE=docs/vikr_full.xlsx

# Qdrant vector index.
GRAPHIT_QDRANT_HOST=localhost
GRAPHIT_QDRANT_PORT=6333
GRAPHIT_QDRANT_COLLECTION=vikr_v6

# Ollama OCR / LLM settings.
GRAPHIT_OLLAMA_URL=http://localhost:11434
GRAPHIT_OCR_MODEL=qwen3.5:27b
GRAPHIT_MERGE_MODEL=gemma3:4b-it-fp16
GRAPHIT_POPPLER_PATH=
GRAPHIT_MAX_PARALLEL_OCR=1
GRAPHIT_FAST_PREPROCESS=true
GRAPHIT_OCR_DPI=250
GRAPHIT_OCR_NUM_PREDICT=4096

# Matching.
GRAPHIT_TOP_K=5
GRAPHIT_BATCH_SIZE=16
GRAPHIT_USE_GPU_SEARCH=true
